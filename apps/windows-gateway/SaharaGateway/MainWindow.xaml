<Window
    x:Class="SaharaGateway.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sahara Gateway">

    <Grid Padding="32">

        <StackPanel Spacing="16">

            <TextBlock
                Text="SAHARA"
                FontSize="36"
                FontWeight="Bold" />

            <TextBlock
                Text="RESCUEMESH Windows Gateway"
                FontSize="20" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                Margin="0,16,0,0">

                <Button
                    Content="Start BLE Gateway"
                    Click="StartGateway_Click" />

                <Button
                    Content="Stop BLE Gateway"
                    Click="StopGateway_Click" />

            </StackPanel>

            <TextBlock
                Text="Status"
                FontWeight="SemiBold"
                Margin="0,20,0,0" />

            <TextBlock
                x:Name="StatusText"
                Text="Gateway stopped"
                FontSize="18"
                TextWrapping="Wrap" />

            <TextBlock
                Text="Latest BLE Message"
                FontWeight="SemiBold"
                Margin="0,20,0,0" />

            <TextBox
                x:Name="MessageTextBox"
                Height="220"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />

        </StackPanel>

    </Grid>

</Window>