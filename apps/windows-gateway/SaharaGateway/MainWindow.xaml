<Window
    x:Class="SaharaGateway.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sahara Gateway">

    <Grid Padding="32">

        <StackPanel Spacing="16">

            <TextBlock
                Text="SAHARA"
                FontSize="36"
                FontWeight="Bold" />

            <TextBlock
                Text="RESCUEMESH Windows Gateway"
                FontSize="20" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="12">

                <Button
                    Content="Start BLE Gateway"
                    Click="StartGateway_Click" />

                <Button
                    Content="Stop BLE Gateway"
                    Click="StopGateway_Click" />

            </StackPanel>

            <TextBlock
                Text="Gateway Status"
                FontWeight="SemiBold" />

            <TextBlock
                x:Name="StatusText"
                Text="Gateway stopped"
                TextWrapping="Wrap" />

            <TextBlock
                Text="FastAPI Status"
                FontWeight="SemiBold"
                Margin="0,12,0,0" />

            <TextBlock
                x:Name="ApiStatusText"
                Text="No request sent yet"
                TextWrapping="Wrap" />

            <TextBlock
                Text="Latest SOS JSON"
                FontWeight="SemiBold"
                Margin="0,12,0,0" />

            <TextBox
                x:Name="MessageTextBox"
                Height="220"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />

        </StackPanel>

    </Grid>

</Window>